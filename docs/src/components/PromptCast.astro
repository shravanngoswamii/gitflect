---
import 'asciinema-player/dist/bundle/asciinema-player.css';
---

<div class="prompt-player" data-prompt-player aria-label="gitflect prompt asciinema recording"></div>

<script>
	import * as AsciinemaPlayer from 'asciinema-player';

	const target = document.querySelector('[data-prompt-player]');
	if (target) {
		const base = import.meta.env.BASE_URL || '/';
		const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
		const castPath = `${normalizedBase}/casts/gitflect-prompt.cast`;

		AsciinemaPlayer.create(castPath, target, {
			autoplay: true,
			loop: true,
			speed: 1.08,
			idleTimeLimit: 1.1,
			cols: 82,
			rows: 12,
			fit: false,
			theme: 'asciinema',
		});
	}
</script>
