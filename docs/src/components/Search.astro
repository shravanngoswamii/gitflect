---
import '@pagefind/default-ui/css/ui.css';
---

<div class="site-search" data-search data-pagefind-ignore>
	<button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
		<svg aria-hidden="true" viewBox="0 0 24 24">
			<path
				d="m20 20-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-width="2"
			/>
		</svg>
		<span>Search docs</span>
	</button>
	<dialog class="search-modal" data-search-modal aria-label="Search documentation">
		<div class="search-panel">
			<header>
				<strong>Search docs</strong>
				<button type="button" data-search-close aria-label="Close search">Esc</button>
			</header>
			{import.meta.env.DEV && (
				<p class="search-dev-notice">
					Search index is not available in the dev server -- run <code>npm run build</code> then <code>npm run preview</code> to use search.
				</p>
			)}
			<div id="pagefind-search" data-pagefind-target></div>
		</div>
	</dialog>
</div>

<script>
	import { PagefindUI } from '@pagefind/default-ui';

	const root = document.querySelector('[data-search]');
	const openButton = root?.querySelector('[data-search-open]');
	const modal = root?.querySelector('[data-search-modal]');
	const closeButton = root?.querySelector('[data-search-close]');
	const base = import.meta.env.BASE_URL || '/';
	const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
	let searchUi: InstanceType<typeof PagefindUI> | undefined;

	const withBase = (url: string) => {
		if (!url || /^(https?:|mailto:|#)/.test(url)) return url;
		if (normalizedBase && url.startsWith(normalizedBase)) return url;
		return `${normalizedBase}${url.startsWith('/') ? url : `/${url}`}` || url;
	};

	const rewriteResult = (result: Record<string, any>) => {
		const next = {
			...result,
			url: withBase(result.url),
			meta: { ...result.meta },
			sub_results: result.sub_results?.map((item: Record<string, any>) => ({ ...item, url: withBase(item.url) })),
		};
		if (next.meta.url) next.meta.url = withBase(next.meta.url);
		return next;
	};

	const ensureSearch = () => {
		if (searchUi) return;
		if (import.meta.env.DEV) {
			console.warn(
				'[gitflect] Pagefind search is not available in the dev server.\n' +
				'Run `astro build` then `astro preview` to enable search.',
			);
			return;
		}
		try {
			searchUi = new PagefindUI({
				element: '#pagefind-search',
				bundlePath: `${normalizedBase}/pagefind/`,
				showImages: false,
				showSubResults: true,
				excerptLength: 24,
				resetStyles: false,
				processResult: rewriteResult,
			});
		} catch (err) {
			console.warn('[gitflect] Failed to initialise Pagefind search:', err);
		}
	};

	const openSearch = () => {
		if (!(modal instanceof HTMLDialogElement)) return;
		ensureSearch();
		modal.showModal();
		requestAnimationFrame(() => modal.querySelector('input')?.focus());
	};

	const closeSearch = () => {
		if (modal instanceof HTMLDialogElement && modal.open) modal.close();
		if (openButton instanceof HTMLElement) openButton.focus();
	};

	const followResult = (event: Event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		if (target.closest('a, button, input')) return;
		const result = target.closest('.pagefind-ui__result, .pagefind-ui__result-nested');
		const link = result?.querySelector('.pagefind-ui__result-link');
		if (link instanceof HTMLAnchorElement && link.href) {
			window.location.href = link.href;
		}
	};

	openButton?.addEventListener('click', openSearch);
	closeButton?.addEventListener('click', closeSearch);
	document.addEventListener('gitflect:open-search', openSearch);
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) closeSearch();
	});
	modal?.addEventListener('click', followResult);
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			openSearch();
		}
	});
</script>
