---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptCast from '../components/PromptCast.astro';
import { withBase } from '../lib/paths';

const siteOrigin = Astro.site ?? Astro.url;
const appUrl = new URL(withBase('/'), siteOrigin).href;
const installUrl = new URL(withBase('/docs/start/install/'), siteOrigin).href;
const configUrl = new URL(withBase('/docs/use/configuration/'), siteOrigin).href;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'gitflect',
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'Linux, macOS',
		description: 'A fast Git-aware prompt helper for Bash and Zsh.',
		url: appUrl,
		downloadUrl: 'https://github.com/shravanngoswamii/gitflect/releases',
		author: {
			'@type': 'Person',
			name: 'Shravan Goswami',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'What is gitflect?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'gitflect is a native CLI that adds compact Git repository status to Bash and Zsh prompts.',
				},
			},
			{
				'@type': 'Question',
				name: 'Which shells and operating systems are supported?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'gitflect supports Bash and Zsh on Linux and macOS.',
				},
			},
			{
				'@type': 'Question',
				name: 'How do I install gitflect?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: `Install from ${installUrl}.`,
				},
			},
			{
				'@type': 'Question',
				name: 'Can I customize symbols and behavior?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: `Yes. Configuration options are documented at ${configUrl}.`,
				},
			},
		],
	},
];
---

<BaseLayout
	title="gitflect"
	description="A fast Git-aware prompt helper for Bash and Zsh on Linux and macOS."
	structuredData={structuredData}
>
	<section class="hero">
		<h1>Git context, kept close to your prompt.</h1>
		<div class="actions">
			<a class="button" href={withBase('/docs/start/install/')}>Install gitflect</a>
			<a class="button secondary" href={withBase('/docs/')}>Read the docs</a>
		</div>
		<div class="hero-demo">
			<div class="terminal-chrome">
				<span class="chrome-dots">
					<span></span><span></span><span></span>
				</span>
				<span class="chrome-title">gitflect — bash</span>
			</div>
			<PromptCast />
		</div>
		<p class="hero-copy">
			<code>gitflect</code> adds a compact repository segment to the prompt you already
			use. It shows branch state, file counts, upstream divergence, in-progress
			operations, and completions without becoming a shell framework.
		</p>
	</section>

	<section class="section">
		<div class="section-header">
			<h2>Small by design.</h2>
			<p>
				<code>gitflect</code> focuses on one job: render Git state quickly and predictably
				for interactive shells.
			</p>
		</div>
		<div class="feature-grid">
			<div class="feature">
				<h3>Preserves your prompt</h3>
				<p>Keeps username, host, path, colors, and prompt marker intact by default.</p>
			</div>
			<div class="feature">
				<h3>Git-aware output</h3>
				<p>Shows branch, detached HEAD, dirty counts, stash count, and operation state.</p>
			</div>
			<div class="feature">
				<h3>Native binary</h3>
				<p>Built in Rust for low startup overhead and simple GitHub release installs.</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<h2>Start in one line.</h2>
			<p>Install from GitHub Releases, then load the shell integration.</p>
		</div>
		<div class="install-strip">
			<div>
				<strong>GitHub release installer</strong>
				<span>Fetches the right archive, installs into your user bin path, and leaves shell setup explicit.</span>
			</div>
			<pre><code>curl -fsSL https://raw.githubusercontent.com/shravanngoswamii/gitflect/main/install.sh | sh</code></pre>
			<a class="button secondary" href={withBase('/docs/start/shell-setup/')}>Shell setup</a>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<h2>Documentation.</h2>
			<p>Focused pages for installation, prompt behavior, configuration, completions, and releases.</p>
		</div>
		<div class="docs-grid">
			<a class="doc-link" href={withBase('/docs/start/install/')}>
				<h3>Install</h3>
				<p>Download the right release archive and place `gitflect` on your path.</p>
			</a>
			<a class="doc-link" href={withBase('/docs/use/prompt-segments/')}>
				<h3>Prompt segments</h3>
				<p>Understand branch symbols, dirty counts, upstream state, and operation markers.</p>
			</a>
			<a class="doc-link" href={withBase('/docs/use/configuration/')}>
				<h3>Configuration</h3>
				<p>Tune colors, symbols, status behavior, branch display, and large repository handling.</p>
			</a>
		</div>
	</section>

	<section class="section attribution-section">
		<p class="attribution">
			gitflect's prompt format and status symbols are directly inspired by <a href="https://github.com/dahlbyk/posh-git" target="_blank">posh-git</a> — the Git integration for PowerShell — adapted for Bash and Zsh on Linux and macOS.
		</p>
	</section>

	<section class="section">
		<div class="section-header">
			<h2>FAQ</h2>
			<p>Quick answers for search engines and humans.</p>
		</div>
		<div class="feature-grid">
			<div class="feature">
				<h3>What is gitflect?</h3>
				<p>A native CLI that shows Git branch and status context in your existing shell prompt.</p>
			</div>
			<div class="feature">
				<h3>Which shells are supported?</h3>
				<p>Bash and Zsh on Linux and macOS.</p>
			</div>
			<div class="feature">
				<h3>Can I customize it?</h3>
				<p>Yes. You can tune colors, symbols, and behavior with config keys.</p>
			</div>
		</div>
	</section>
</BaseLayout>
