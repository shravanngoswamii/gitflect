---
import '../styles/global.css';
import { quickLinks } from '../data/navigation';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.astro';

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}

const {
	title = 'gitflect',
	description = 'Fast Git-aware prompt context for Bash and Zsh.',
	bodyClass = '',
} = Astro.props;
const pageTitle = title === 'gitflect' ? 'gitflect' : `${title} | gitflect`;
const sponsorUrl = 'https://github.com/sponsors/shravanngoswamii';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				const key = 'gitflect-theme';
				const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				const stored = localStorage.getItem(key);
				document.documentElement.dataset.theme = stored || preferred;
			})();
		</script>
	</head>
	<body class={bodyClass}>
		<header class="site-header" data-pagefind-ignore>
			<a class="brand" href="/" aria-label="gitflect home">
				<Logo />
				<span>gitflect</span>
			</a>
			<Search />
			<nav class="top-nav" aria-label="Main navigation">
				<a href="/docs/">Docs</a>
				<a href="/docs/start/install/">Install</a>
				<a href={sponsorUrl}>Sponsor</a>
				<a href="https://github.com/shravanngoswamii/gitflect">GitHub</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
				<span aria-hidden="true"></span>
				Theme
			</button>
		</header>
		<main data-pagefind-body>
			<slot />
		</main>
		<footer class="site-footer" data-pagefind-ignore>
			<div>
				<strong>gitflect</strong>
				<span>Fast Git context for Unix shells.</span>
			</div>
			<nav aria-label="Footer navigation">
				{quickLinks.slice(0, 4).map((link) => <a href={link.href}>{link.title}</a>)}
				<a href={sponsorUrl}>Sponsor</a>
				<a href="https://github.com/shravanngoswamii/gitflect">GitHub</a>
			</nav>
		</footer>
		<script is:inline>
			(() => {
				const key = 'gitflect-theme';
				const root = document.documentElement;
				const button = document.querySelector('[data-theme-toggle]');
				const apply = (theme) => {
					root.dataset.theme = theme;
					button?.setAttribute('aria-pressed', String(theme === 'dark'));
				};

				button?.addEventListener('click', () => {
					const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					localStorage.setItem(key, next);
					apply(next);
				});

				apply(root.dataset.theme || 'light');
			})();
		</script>
	</body>
</html>
