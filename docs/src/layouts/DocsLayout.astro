---
import BaseLayout from './BaseLayout.astro';
import { navGroups } from '../data/navigation';

const { frontmatter } = Astro.props;
const title = frontmatter.title ?? 'Docs';
const description = frontmatter.description ?? 'gitflect documentation.';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isCurrent = (href: string) => {
	const normalized = href.replace(/\/$/, '') || '/';
	return normalized === currentPath;
};
---

<BaseLayout title={title} description={description} bodyClass="docs-page">
	<div class="docs-shell">
		<aside class="docs-sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
			<a class="docs-home" href="/docs/">Documentation</a>
			{
				navGroups.map((group) => (
					<section>
						<h2>{group.title}</h2>
						<ul>
							{group.items.map((item) => (
								<li>
									<a class:list={{ active: isCurrent(item.href) }} href={item.href}>
										{item.title}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</aside>
		<article class="docs-content" data-pagefind-body>
			<header class="docs-title">
				<p>Documentation</p>
				<h1>{title}</h1>
				{description && <span>{description}</span>}
			</header>
			<div class="prose">
				<slot />
			</div>
		</article>
	</div>
</BaseLayout>
